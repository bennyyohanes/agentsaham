# ============================================================
#  AgentSaham — Environment Variables Example
#  Copy this file to .env and fill in your values.
# ============================================================

# -------------------------------------------------------
# 🔑 Gemini API Key (WAJIB)
# Dapatkan gratis di: https://makersuite.google.com/app/apikey
# -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# 🤖 Telegram Bot (Opsional — untuk notifikasi)
# Cara setup: https://core.telegram.org/bots#botfather
# -------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -------------------------------------------------------
# 🎙️ Whisper Model Size
# Options: tiny, base, small (default), medium, large-v3
# Semakin besar = akurasi lebih tinggi tapi lebih lambat
# -------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# -------------------------------------------------------
# ⚖️ Bobot Voting (total harus = 1.0)
# -------------------------------------------------------
WEIGHT_TECHNICAL=0.35
WEIGHT_FUNDAMENTAL=0.40
WEIGHT_TRANSACTION=0.25

# -------------------------------------------------------
# 📦 Cache & Logging
# -------------------------------------------------------
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
LOG_FILE=logs/agentsaham.log
